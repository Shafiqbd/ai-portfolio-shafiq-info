# Nothing here is required yet — apps/web currently reads from data/*.json,
# not from any external service or database. This file documents the shape
# env vars will take as later phases land, so nothing has to be invented
# later under time pressure.

# --- apps/web (in use today) ---
NEXT_PUBLIC_SITE_URL=https://shafiq.info.bd

# --- apps/api (Phase 9 — in progress) ---
# Discrete Postgres fields (not a single DATABASE_URL) so passwords with
# reserved URL characters (&, %, etc.) don't need percent-encoding.
# Values below match docker-compose.yml's postgres service for local dev;
# point at a real test/staging database instead if you have one.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=shafiq_info
DB_PASSWORD=shafiq_info
DB_DATABASE=shafiq_info
REDIS_URL=redis://localhost:6379
PORT=4000
# Used by apps/web (server-side only, never NEXT_PUBLIC_) once Phase 9's B7
# frontend wiring lands — where to reach apps/api from Next's server process.
API_URL=http://localhost:4000

# --- AI / RAG (Phase 12 — not implemented) ---
# LLM_API_KEY=

# --- Deployment (Phase 15) ---
# The values above are for LOCAL DEV only. Production runs on a VPS with its
# own .env (never committed — see DEPLOYMENT.md), where DB_HOST/REDIS_URL/
# API_URL point at the VPS's actual services (e.g. REDIS_URL=redis://redis:6379
# and API_URL=http://api:4000, Docker's internal service names, since
# docker-compose.prod.yml runs web/api/redis as containers on one network).
# WEB_IMAGE_TAG/API_IMAGE_TAG are optional overrides docker-compose.prod.yml
# reads to pin a specific image tag (e.g. for a manual rollback) — they
# default to "latest" and don't need to be set for a normal deploy.
# WEB_IMAGE_TAG=
# API_IMAGE_TAG=
