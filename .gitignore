# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
apps/web/node_modules
apps/api/node_modules
packages/*/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
# Compiled NestJS output (apps/api) — unanchored so it also catches any
# future dist/ dir elsewhere in the workspace, same reasoning as node_modules.
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — real secrets live only in .env, never committed. .env.example
# is the one allowed exception (re-allowed below) since it documents shape
# only, no real values.
.env
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
